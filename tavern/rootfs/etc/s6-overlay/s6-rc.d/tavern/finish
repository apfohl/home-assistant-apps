#!/usr/bin/with-contenv bashio
# ==============================================================================
# Handle Tavern service exit
# ==============================================================================
bashio::log.info "Tavern service exited with code ${1}"

if [ "${1}" != "0" ] && [ "${1}" != "256" ]; then
    bashio::log.warning "Tavern exited unexpectedly, stopping container"
    echo "${1}" > /run/s6-linux-init-container-results/exitcode
    halt
else
    bashio::log.info "Tavern restarting..."
fi
