#!/usr/bin/with-contenv bashio
# ==============================================================================
# Handle Protocol Test service exit
# ==============================================================================
bashio::log.info "Protocol Test service exited with code ${1}"

if [ "${1}" != "0" ] && [ "${1}" != "256" ]; then
    bashio::log.warning "Protocol Test exited unexpectedly, stopping container"
    echo "${1}" > /run/s6-linux-init-container-results/exitcode
    halt
else
    bashio::log.info "Protocol Test restarting..."
fi
